        private void KeyIsDown(object sender, KeyEventArgs e)
        {
            // LEFT arrow, and no wall blocking the left
            if (e.KeyCode == Keys.Left && noLeft == false)
            {
                goRight = goDown = goUp = false;     // stop the other directions
                noRight = noDown = noUp = false;     // clear the other wall blocks
                goLeft = true;                       // start moving left
                // use cached flipped sprite
                if (pacmanLeftBmp != null) pacman.Image = pacmanLeftBmp;
            }

            // RIGHT arrow
            if (e.KeyCode == Keys.Right && noRight == false)
            {
                goLeft = goUp = goDown = false;
                noLeft = noUp = noDown = false;
                goRight = true;
                if (pacmanRightBmp != null) pacman.Image = pacmanRightBmp;
            }

            // UP arrow
            if (e.KeyCode == Keys.Up && noUp == false)
            {
                goLeft = goRight = goDown = false;
                noLeft = noRight = noDown = false;
                goUp = true;
                if (pacmanUpBmp != null) pacman.Image = pacmanUpBmp;
            }

            // DOWN arrow
            if (e.KeyCode == Keys.Down && noDown == false)
            {
                goLeft = goRight = goUp = false;
                noLeft = noRight = noUp = false;
                goDown = true;
                if (pacmanDownBmp != null) pacman.Image = pacmanDownBmp;
            }
        }

        // Create flipped/rotated sprites once from a single source sprite
        private void CreatePacmanSprites()
        {
            // Assume the project currently contains a right-facing resource named "right".
            // We create clones and RotateFlip them to get other directions.
            try
            {
                if (Properties.Resources.right != null)
                {
                    pacmanRightBmp = new Bitmap(Properties.Resources.right);

                    pacmanLeftBmp = (Bitmap)pacmanRightBmp.Clone();
                    pacmanLeftBmp.RotateFlip(RotateFlipType.RotateNoneFlipX);

                    pacmanUpBmp = (Bitmap)pacmanRightBmp.Clone();
                    pacmanUpBmp.RotateFlip(RotateFlipType.Rotate270FlipNone);

                    pacmanDownBmp = (Bitmap)pacmanRightBmp.Clone();
                    pacmanDownBmp.RotateFlip(RotateFlipType.Rotate90FlipNone);
                }
            }
            catch
            {
                // If resources are missing or creation fails, fall back to existing resources.
                // Do nothing here; KeyIsDown checks for null and original resources still exist.
            }
        }

        private void Form1_FormClosed(object? sender, FormClosedEventArgs e)
        {
            pacmanRightBmp?.Dispose();
            pacmanLeftBmp?.Dispose();
            pacmanUpBmp?.Dispose();
            pacmanDownBmp?.Dispose();
        }

