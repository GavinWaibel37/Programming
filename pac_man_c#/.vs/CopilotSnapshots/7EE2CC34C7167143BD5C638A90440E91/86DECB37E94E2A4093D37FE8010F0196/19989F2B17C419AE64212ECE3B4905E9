        private void KeyIsDown(object sender, KeyEventArgs e)
        {
            // LEFT arrow, and no wall blocking the left
            if (e.KeyCode == Keys.Left && noLeft == false)
            {
                goRight = goDown = goUp = false;     // stop the other directions
                noRight = noDown = noUp = false;     // clear the other wall blocks
                goLeft = true;                       // start moving left
                // use cached flipped sprite if we are not using an animated GIF
                if (!isGifAnimated && pacmanLeftBmp != null) pacman.Image = pacmanLeftBmp;
            }

            // RIGHT arrow
            if (e.KeyCode == Keys.Right && noRight == false)
            {
                goLeft = goUp = goDown = false;
                noLeft = noUp = noDown = false;
                goRight = true;
                if (!isGifAnimated && pacmanRightBmp != null) pacman.Image = pacmanRightBmp;
            }

            // UP arrow
            if (e.KeyCode == Keys.Up && noUp == false)
            {
                goLeft = goRight = goDown = false;
                noLeft = noRight = noDown = false;
                goUp = true;
                if (!isGifAnimated && pacmanUpBmp != null) pacman.Image = pacmanUpBmp;
            }

            // DOWN arrow
            if (e.KeyCode == Keys.Down && noDown == false)
            {
                goLeft = goRight = goUp = false;
                noLeft = noRight = noUp = false;
                goDown = true;
                if (!isGifAnimated && pacmanDownBmp != null) pacman.Image = pacmanDownBmp;
            }
        }

        // Create flipped/rotated sprites once from a single source sprite
        private void CreatePacmanSprites()
        {
            // Assume the project currently contains a right-facing resource named "right".
            // We create clones and RotateFlip them to get other directions.
            try
            {
                if (Properties.Resources.right != null)
                {
                    pacmanRightBmp = new Bitmap(Properties.Resources.right);

                    pacmanLeftBmp = (Bitmap)pacmanRightBmp.Clone();
                    pacmanLeftBmp.RotateFlip(RotateFlipType.RotateNoneFlipX);

                    pacmanUpBmp = (Bitmap)pacmanRightBmp.Clone();
                    pacmanUpBmp.RotateFlip(RotateFlipType.Rotate270FlipNone);

                    pacmanDownBmp = (Bitmap)pacmanRightBmp.Clone();
                    pacmanDownBmp.RotateFlip(RotateFlipType.Rotate90FlipNone);
                }

                // Try to find an animated GIF in resources. Common names: "pacman", "pacmanGif", "pacman_gif"
                try
                {
                    object? o = Properties.Resources.ResourceManager.GetObject("pacmanGif")
                                ?? Properties.Resources.ResourceManager.GetObject("pacman_gif")
                                ?? Properties.Resources.ResourceManager.GetObject("pacman");

                    if (o is Image img && ImageAnimator.CanAnimate(img))
                    {
                        pacmanAnimatedGif = img;
                        isGifAnimated = true;
                        // Start animation and repaint on frame changes
                        ImageAnimator.Animate(pacmanAnimatedGif, new EventHandler(OnFrameChanged));
                        // Use custom painting so we can flip the image for directions
                        pacman.Paint += Pacman_Paint;
                        // Clear any static image so painting is used
                        pacman.Image = null;
                    }
                }
                catch
                {
                    // ignore resource lookup failures
                }
            }
            catch
            {
                // If resources are missing or creation fails, fall back to existing resources.
                // Do nothing here; KeyIsDown checks for null and original resources still exist.
            }
        }

        private void OnFrameChanged(object? o, EventArgs e)
        {
            // Request repaint of the pacman PictureBox so the new frame is drawn
            pacman?.Invalidate();
        }

        private void Pacman_Paint(object? sender, PaintEventArgs e)
        {
            if (!isGifAnimated || pacmanAnimatedGif == null) return;

            // Update to the current frame
            ImageAnimator.UpdateFrames(pacmanAnimatedGif);

            Graphics g = e.Graphics;
            Rectangle dest = new Rectangle(0, 0, pacman.Width, pacman.Height);

            g.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.HighQualityBicubic;

            // Draw based on direction, applying transforms for flipped/rotated cases
            if (goLeft)
            {
                // Flip horizontally
                g.TranslateTransform(dest.Width, 0);
                g.ScaleTransform(-1, 1);
                g.DrawImage(pacmanAnimatedGif, new Rectangle(0, 0, dest.Width, dest.Height));
                g.ResetTransform();
            }
            else if (goRight)
            {
                g.DrawImage(pacmanAnimatedGif, dest);
            }
            else if (goUp)
            {
                // Rotate -90 degrees around center
                g.TranslateTransform(dest.Width / 2f, dest.Height / 2f);
                g.RotateTransform(-90);
                g.TranslateTransform(-dest.Height / 2f, -dest.Width / 2f);
                g.DrawImage(pacmanAnimatedGif, new Rectangle(0, 0, dest.Height, dest.Width));
                g.ResetTransform();
            }
            else if (goDown)
            {
                // Rotate 90 degrees around center
                g.TranslateTransform(dest.Width / 2f, dest.Height / 2f);
                g.RotateTransform(90);
                g.TranslateTransform(-dest.Height / 2f, -dest.Width / 2f);
                g.DrawImage(pacmanAnimatedGif, new Rectangle(0, 0, dest.Height, dest.Width));
                g.ResetTransform();
            }
            else
            {
                // Default: draw facing right
                g.DrawImage(pacmanAnimatedGif, dest);
            }
        }

        private void Form1_FormClosed(object? sender, FormClosedEventArgs e)
        {
            pacmanRightBmp?.Dispose();
            pacmanLeftBmp?.Dispose();
            pacmanUpBmp?.Dispose();
            pacmanDownBmp?.Dispose();
            if (isGifAnimated && pacmanAnimatedGif != null)
            {
                try { ImageAnimator.StopAnimate(pacmanAnimatedGif, new EventHandler(OnFrameChanged)); } catch { }
            }
        }

